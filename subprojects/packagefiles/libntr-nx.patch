+// ---- NX_SAMPLER ----
+#ifdef SDK_BUILD_NX
+extern "C" char __start__;
+static Handle sNxMainThread;
+extern volatile int sNxPhase;
+struct NxBin { u64 key; u32 count; };
+static NxBin sNxPc[1 << 15], sNxLr[1 << 15];
+static u64 sNxSamples, sNxFailed;
+static void NxBinAdd(NxBin *t, u64 key) {
+  u32 i = (u32)((key >> 2) * 2654435761u) & ((1 << 15) - 1);
+  for (int probe = 0; probe < 64; probe++, i = (i + 1) & ((1 << 15) - 1)) {
+    if (t[i].key == key) { t[i].count++; return; }
+    if (!t[i].key) { t[i].key = key; t[i].count = 1; return; }
+  }
+}
+struct NxStack { u64 key[10]; u32 count; };  // phase+1, pc, lr, 7 frame-chain return addresses
+static NxStack sNxStk[8192];
+static u64 sNxStkDropped, sNxStackLo, sNxStackHi;
+static void NxStackAdd(const u64 *key) {
+  u64 h = 1469598103934665603ull;
+  for (int i = 0; i < 10; i++) h = (h ^ key[i]) * 1099511628211ull;
+  u32 idx = (u32)(h >> 20) & 8191;
+  for (int probe = 0; probe < 32; probe++, idx = (idx + 1) & 8191) {
+    NxStack &e = sNxStk[idx];
+    if (!e.count) { memcpy(e.key, key, sizeof e.key); e.count = 1; return; }
+    if (!memcmp(e.key, key, sizeof e.key)) { e.count++; return; }
+  }
+  sNxStkDropped++;
+}
+static void NxProfThread(void *);
+static void NxProfDump() {
+  FILE *f = fopen("sdmc:/switch/pokeplatinum_ss/prof.txt", "w");
+  if (!f) return;
+  fprintf(f, "fnref %llx ", (unsigned long long)(uintptr_t)&NxProfThread);
+  fprintf(f, "base %llx samples %llu failed %llu\n", (unsigned long long)(uintptr_t)&__start__,
+          (unsigned long long)sNxSamples, (unsigned long long)sNxFailed);
+  for (auto &b : sNxPc) if (b.key) fprintf(f, "P %llx %u\n", (unsigned long long)b.key, b.count);
+  for (auto &b : sNxLr) if (b.key) fprintf(f, "L %llx %u\n", (unsigned long long)b.key, b.count);
+  fprintf(f, "dropped %llu\n", (unsigned long long)sNxStkDropped);
+  for (auto &e : sNxStk) if (e.count) {
+    fprintf(f, "S %u", e.count);
+    for (u64 k : e.key) fprintf(f, " %llx", (unsigned long long)k);
+    fputc('\n', f);
+  }
+  fclose(f);
+}
+static void NxProfThread(void *) {
+  const u64 base = (uintptr_t)&__start__;
+  for (;;) {
+    svcSleepThread(2000000);  // ~500 Hz
+    if (R_FAILED(svcSetThreadActivity(sNxMainThread, ThreadActivity_Paused))) { sNxFailed++; continue; }
+    ThreadContext ctx;
+    Result r = 1;
+    for (int tries = 0; tries < 8 && R_FAILED(r); tries++) { r = svcGetThreadContext3(&ctx, sNxMainThread); if (R_FAILED(r)) svcSleepThread(20000); }
+    u64 chain[7] = {0};
+    if (R_SUCCEEDED(r)) {
+      if (!sNxStackHi) {
+        MemoryInfo mi; u32 pi;
+        if (R_SUCCEEDED(svcQueryMemory(&mi, &pi, ctx.sp))) { sNxStackLo = mi.addr; sNxStackHi = mi.addr + mi.size; }
+      }
+      u64 fp = ctx.fp, floor = ctx.sp;
+      for (int d = 0; d < 7 && fp >= floor && fp >= sNxStackLo && fp + 16 <= sNxStackHi && !(fp & 7); d++) {
+        const u64 *frame = (const u64 *)fp;
+        chain[d] = frame[1] ? frame[1] - base + 1 : 0;
+        floor = fp + 16;
+        fp = frame[0];
+      }
+    }
+    svcSetThreadActivity(sNxMainThread, ThreadActivity_Runnable);
+    if (R_FAILED(r)) { sNxFailed++; continue; }
+    const int phase = sNxPhase;
+    if (phase < 0) continue;  // NX: ignore boot (shader compile)
+    NxBinAdd(sNxPc, (ctx.pc.x - base + 1) | ((u64)(phase + 1) << 52));  // +1: 0 marks an empty bin
+    NxBinAdd(sNxLr, (ctx.lr - base + 1) | ((u64)(phase + 1) << 52));
+    { u64 key[10] = {(u64)(phase + 1), ctx.pc.x - base + 1, ctx.lr - base + 1, chain[0], chain[1], chain[2], chain[3], chain[4], chain[5], chain[6]};
+      NxStackAdd(key); }
+    if (++sNxSamples % 5000 == 0) NxProfDump();
+  }
+}
+extern "C" Result __real_threadCreate(Thread *t, ThreadFunc entry, void *arg, void *stack_mem, size_t stack_sz, int prio, int cpuid);
+static int sNxThreadCore = -2;  // -2: libnx default (process main core); -3: alternate 1/2
+static int sNxThreadCount;
+extern "C" Result __wrap_threadCreate(Thread *t, ThreadFunc entry, void *arg, void *stack_mem, size_t stack_sz, int prio, int cpuid) {
+  int core = cpuid;
+  if (cpuid == -2 && sNxThreadCore != -2) core = sNxThreadCore == -3 ? 1 + (sNxThreadCount & 1) : sNxThreadCore;
+  Result r = __real_threadCreate(t, entry, arg, stack_mem, stack_sz, prio, core);
+  char b[160];
+  snprintf(b, sizeof b, "thread #%d entry +%llx prio 0x%x core %d->%d stack %zu r=%x", sNxThreadCount++,
+           (unsigned long long)((uintptr_t)entry - (uintptr_t)&__start__), prio, cpuid, core, stack_sz, r);
+  NX_BootTrace(b);
+  return r;
+}
+static void NxSamplerStart() {
+  sNxMainThread = threadGetCurHandle();
+  if (const char *c = getenv("NX_THREAD_CORE")) sNxThreadCore = !strcmp(c, "rr") ? -3 : atoi(c);
+  const char *p = getenv("NX_PROF");
+  if (!p || *p != '1') { NX_BootTrace("sampler off (NX_PROF=1 enables)"); return; }
+  static Thread th;
+  Result r = __real_threadCreate(&th, NxProfThread, NULL, NULL, 0x8000, 0x20, 2);
+  if (R_SUCCEEDED(r)) r = threadStart(&th);
+  char b[96]; snprintf(b, sizeof b, "sampler start r=%x fnref %llx", r, (unsigned long long)(uintptr_t)&NxProfThread); NX_BootTrace(b);
+}
+// CPU accounting for perf_log: main-thread ticks and core-0 idle ticks since last call
+static void NxCpuStats(double *mainPct, double *core0Pct) {
+  static u64 lastWall, lastMain, lastIdle;
+  u64 wall = armGetSystemTick(), mainT = 0, idle = 0;
+  svcGetInfo(&mainT, InfoType_ThreadTickCount, CUR_THREAD_HANDLE, (u64)-1);
+  svcGetInfo(&idle, InfoType_IdleTickCount, INVALID_HANDLE, (u64)-1);
+  const double dw = (double)(wall - lastWall);
+  *mainPct = lastWall ? 100.0 * (double)(mainT - lastMain) / dw : 0;
+  *core0Pct = lastWall ? 100.0 - 100.0 * (double)(idle - lastIdle) / dw : 0;
+  lastWall = wall; lastMain = mainT; lastIdle = idle;
+}
+#endif
+// ---- end NX_SAMPLER ----
