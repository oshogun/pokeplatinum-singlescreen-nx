+// ---- NX_PERF ----
+#ifdef SDK_BUILD_NX
+// Frame steps, in order. Mark i is taken at the END of step i; step 0 starts at the previous frame's end.
+static const int kNxOrder[] = {0, 1, 2, 6, 7, 8, 9, 3, 4, 10, 11, 5};
+static const char *kNxNames[] = {"game", "3d", "bloom", "vblank", "imgui", "post", "evt+gui", "clear", "scan", "draw2d", "pace", "swap"};
+// step that runs AFTER mark i (for sample tagging)
+static int NxNextStep(int mark) {
+  for (int k = 0; k < 11; k++) if (kNxOrder[k] == mark) return kNxOrder[k + 1];
+  return 0;  // after mark 5: game
+}
+volatile int sNxPhase = -1;  // step currently running (-1 before the first frame)
+static u64 sNxW[12], sNxC[12];         // wall / cpu ticks at each mark this frame
+static u64 sNxAccW[12], sNxAccC[12], sNxMaxW[12];
+static u64 sNxLastW, sNxLastC;          // previous frame end
+static int sNxCount, sNxLines;
+static inline u64 NxCpuTicks() { u64 t = 0; svcGetInfo(&t, InfoType_ThreadTickCount, CUR_THREAD_HANDLE, (u64)-1); return t; }
+static void NxMark(int i) {
+  switch (i) {
+    case 5: NxGpuFrameStart(); break;
+    case 1: NxGpuStamp(1); break;
+    case 2: NxGpuStamp(2); break;
+    case 9: NxGpuStamp(4); break;
+    case 4: NxGpuStamp(5); break;
+  }
+  sNxW[i] = armGetSystemTick();
+  sNxC[i] = NxCpuTicks();
+  sNxPhase = NxNextStep(i);
+}
+static void NxFrameEnd(u64, u64 gpuNs) {
+  static u64 sAccGpu;
+  if (!sNxLastW) { sNxLastW = sNxW[5]; sNxLastC = sNxC[5]; return; }
+  u64 pw = sNxLastW, pc = sNxLastC;
+  for (int k = 0; k < 12; k++) {
+    const int i = kNxOrder[k];
+    const u64 w = sNxW[i] - pw, c = sNxC[i] - pc;
+    sNxAccW[i] += w; sNxAccC[i] += c; if (w > sNxMaxW[i]) sNxMaxW[i] = w;
+    pw = sNxW[i]; pc = sNxC[i];
+  }
+  const u64 frameW = sNxW[5] - sNxLastW, frameC = sNxC[5] - sNxLastC;
+  static u64 sAccFrameW, sAccFrameC;
+  sAccFrameW += frameW; sAccFrameC += frameC; sAccGpu += gpuNs;
+  sNxLastW = sNxW[5]; sNxLastC = sNxC[5];
+  if (++sNxCount < 120) return;
+  if (sNxLines++ < 3000) {
+    if (FILE *f = fopen("sdmc:/switch/pokeplatinum_ss/perf_log.txt", sNxLines == 1 ? "w" : "a")) {
+      const double n = sNxCount, ms = 19200.0;  // system tick = 19.2 MHz
+      if (sNxLines == 1) fprintf(f, "per step: wall/cpu ms (avg over 120 frames); idle = wall - cpu\n");
+      fprintf(f, "fps %5.1f wall %5.1f cpu %5.1f gpu %4.1f |", 19200000.0 * n / (double)sAccFrameW, sAccFrameW / n / ms,
+              sAccFrameC / n / ms, sAccGpu / n / 1e6);
+      for (int k = 0; k < 12; k++) {
+        const int i = kNxOrder[k];
+        fprintf(f, " %s %.1f/%.1f", kNxNames[i], sNxAccW[i] / n / ms, sNxAccC[i] / n / ms);
+      }
+      fprintf(f, " | pbo %.2fMB/%.1f up fb %.1f wait %.2fms", sNxPboBytes / n / 1048576.0, sNxPboUploads / n,
+              sNxPboFallback / n, sNxPboWaitTicks / n / ms);
+      fprintf(f, " copies %.1f", sNxCopies / n); sNxCopies = 0;
+      fprintf(f, " | skipped %.2f/frame", sNxSkipped / n); sNxSkipped = 0;
+      fprintf(f, " | dequeue %.2fms x%.1f fencewait %.2fms defer %d", sNxDequeueTicks / n / ms, sNxDequeues / n,
+              sNxFenceWaitTicks / n / ms, sNxDefer);
+      sNxDequeueTicks = sNxFenceWaitTicks = sNxDequeues = 0;
+      if (sNxGpuFrames) {
+        const double g = (double)sNxGpuFrames;
+        fprintf(f, " | GPU 3d %.2f bloom %.2f aa %.2f compose %.2f imgui %.2f tail %.2f frame %.2f (n %llu)",
+                sNxGpuAcc[0] / g, sNxGpuAcc[1] / g, sNxGpuAcc[2] / g, sNxGpuAcc[3] / g, sNxGpuAcc[4] / g, sNxGpuAcc[5] / g,
+                sNxGpuAcc[6] / g, (unsigned long long)sNxGpuFrames);
+      }
+      for (double &a : sNxGpuAcc) a = 0;
+      sNxGpuFrames = 0;
+      sNxPboBytes = sNxPboUploads = sNxPboFallback = sNxPboWaitTicks = 0;
+      fputc('\n', f);
+      fclose(f);
+    }
+  }
+  for (int i = 0; i < 12; i++) { sNxAccW[i] = sNxAccC[i] = sNxMaxW[i] = 0; }
+  sAccFrameW = sAccFrameC = sAccGpu = 0;
+  sNxCount = 0;
+}
+#define NX_SEG(i) NxMark(i)
+#else
+#define NX_SEG(i) ((void)0)
+#endif
+// ---- end NX_PERF ----
