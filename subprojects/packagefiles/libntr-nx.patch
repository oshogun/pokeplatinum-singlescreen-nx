+    good = glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+    if (good && sNxGoodN < 64) sNxGoodTex[sNxGoodN++] = tex;
+    if (!good && sNxBadN < 64) sNxBadTex[sNxBadN++] = tex;
+    char b[96]; snprintf(b, sizeof b, "upload: texture %d fbo %s", tex, good ? "ok" : "INCOMPLETE -> driver path"); NX_BootTrace(b);
+  }
+  if (good) {
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glViewport(x, y, w, h);
+    glActiveTexture(GL_TEXTURE0 + kNxCopyUnit);
+    glGetIntegerv(GL_TEXTURE_BINDING_BUFFER, &prevBufTex);
+    glBindTexture(GL_TEXTURE_BUFFER, sNxBufTex);
+    glTexBufferRange(GL_TEXTURE_BUFFER, bufFmt, sNxPbo, (GLintptr)off, (GLsizeiptr)bytes);
+    glUseProgram(sNxCopyProg[prog]);
+    glUniform4i(sNxCopyRect[prog], x, y, w, h);
+    glBindVertexArray(sNxCopyVao);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    glBindTexture(GL_TEXTURE_BUFFER, prevBufTex);
+    sNxCopies++;
+  }
+  // restore
+  glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0, 0);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, prevFbo);
+  glUseProgram(prevProg);
+  glBindVertexArray(prevVao);
+  glActiveTexture(prevActive);
+  glViewport(vp[0], vp[1], vp[2], vp[3]);
+  glColorMask(mask[0], mask[1], mask[2], mask[3]);
+  for (int i = 0; i < 7; i++) if (on[i]) glEnable(caps[i]);
+  return good;
+}
+extern "C" void NX_TexSubImage2D(unsigned target, int level, int x, int y, int w, int h, unsigned fmt, unsigned type, const void *px) {
+  if (level == 0 && target == GL_TEXTURE_2D && NxGpuCopy(target, x, y, 0, w, h, fmt, type, px)) return;
+  sNxPboFallback++;
+  glad_glTexSubImage2D(target, level, x, y, w, h, fmt, type, px);
+}
+extern "C" void NX_TexSubImage3D(unsigned target, int level, int x, int y, int z, int w, int h, int d, unsigned fmt, unsigned type, const void *px) {
+  if (level == 0 && target == GL_TEXTURE_2D_ARRAY && d == 1 && NxGpuCopy(target, x, y, z, w, h, fmt, type, px)) return;
+  sNxPboFallback++;
+  glad_glTexSubImage3D(target, level, x, y, z, w, h, d, fmt, type, px);
+}
+// Once per frame, before the swap: fence this frame's segment, move to the oldest one.
+static void NxPboFrameEnd() {
+  if (!sNxPboOn) return;
+  if (sNxPboFence[sNxPboSeg]) glDeleteSync(sNxPboFence[sNxPboSeg]);
+  sNxPboFence[sNxPboSeg] = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+  sNxPboSeg = (sNxPboSeg + 1) % kNxSegs;
+  sNxPboHead = 0;
+  if (GLsync s = sNxPboFence[sNxPboSeg]) {
+    const u64 t0 = armGetSystemTick();
+    glClientWaitSync(s, GL_SYNC_FLUSH_COMMANDS_BIT, 100000000ull);
+    sNxPboWaitTicks += armGetSystemTick() - t0;
+    glDeleteSync(s);
+    sNxPboFence[sNxPboSeg] = 0;
+  }
+}
+#endif
+// ---- end NX_PBO ----
+
+// ---- NX_DEFER_FENCE ----
+#ifdef SDK_BUILD_NX
+extern "C" Result __real_nwindowDequeueBuffer(NWindow *nw, s32 *out_slot, NvMultiFence *out_fence);
+static int sNxDefer = -1;  // -1 unknown, 0 off, 1 on
+static bool sNxFencePending;
+static NvMultiFence sNxFence;
+static u64 sNxDequeueTicks, sNxFenceWaitTicks, sNxDequeues;
+static u64 sNxSkipped;  // NX_SKIPDUP
+extern "C" Result __wrap_nwindowDequeueBuffer(NWindow *nw, s32 *out_slot, NvMultiFence *out_fence) {
+  if (sNxDefer < 0) { const char *e = getenv("NX_DEFER_FENCE"); sNxDefer = (e && *e == '0') ? 0 : 1; }
+  const u64 t0 = armGetSystemTick();
+  Result r;
+  if (out_fence || !sNxDefer) {
+    r = __real_nwindowDequeueBuffer(nw, out_slot, out_fence);
+  } else {
+    NvMultiFence f;
+    r = __real_nwindowDequeueBuffer(nw, out_slot, &f);
+    if (R_SUCCEEDED(r)) {
+      if (sNxFencePending) nvMultiFenceWait(&sNxFence, -1);  // never drop an older fence
+      sNxFence = f;
+      sNxFencePending = true;
+    }
+  }
+  sNxDequeueTicks += armGetSystemTick() - t0;
+  sNxDequeues++;
+  return r;
+}
+// Before the first GPU write to the window in this frame.
+static void NxWaitWindowFence() {
+  if (!sNxFencePending) return;
+  const u64 t0 = armGetSystemTick();
+  nvMultiFenceWait(&sNxFence, -1);
+  sNxFenceWaitTicks += armGetSystemTick() - t0;
+  sNxFencePending = false;
+}
+#endif
+// ---- end NX_DEFER_FENCE ----
+
+// ---- NX_GPU_STAMPS ----
+#ifdef SDK_BUILD_NX
+static const int kNxStamps = 6, kNxRing = 5;
+static GLuint sNxQ[kNxRing][kNxStamps];
+static bool sNxQUsed[kNxRing][kNxStamps];
+static int sNxQFrame;  // ring slot written this frame
+static bool sNxQInit;
+static double sNxGpuAcc[kNxStamps + 1];
+static u64 sNxGpuFrames;
+static void NxGpuStamp(int k) {
+  if (!sNxQInit) { glGenQueries(kNxRing * kNxStamps, &sNxQ[0][0]); sNxQInit = true; }
+  glQueryCounter(sNxQ[sNxQFrame][k], GL_TIMESTAMP);
+  sNxQUsed[sNxQFrame][k] = true;
+}
+// Called at frame start (after the swap): read back the oldest slot, then reuse it.
+static void NxGpuFrameStart() {
+  if (!sNxQInit) { NxGpuStamp(0); return; }
+  const int next = (sNxQFrame + 1) % kNxRing;
+  // slot `next` holds frame N-4; its S0..S5, plus S0 of the frame after it (slot next+1)
+  const int after = (next + 1) % kNxRing;
+  bool ok = sNxQUsed[next][0] && sNxQUsed[after][0];
+  for (int k = 1; k < kNxStamps && ok; k++) ok = sNxQUsed[next][k];
+  if (ok) {
+    GLint avail = 0;
+    glGetQueryObjectiv(sNxQ[after][0], GL_QUERY_RESULT_AVAILABLE, &avail);
+    if (avail) {
+      GLuint64 t[kNxStamps + 1];
+      for (int k = 0; k < kNxStamps; k++) glGetQueryObjectui64v(sNxQ[next][k], GL_QUERY_RESULT, &t[k]);
+      glGetQueryObjectui64v(sNxQ[after][0], GL_QUERY_RESULT, &t[kNxStamps]);
+      for (int k = 0; k < kNxStamps; k++) sNxGpuAcc[k] += (double)(t[k + 1] - t[k]) / 1e6;
+      sNxGpuAcc[kNxStamps] += (double)(t[kNxStamps] - t[0]) / 1e6;
+      sNxGpuFrames++;
+    }
+  }
+  for (int k = 0; k < kNxStamps; k++) sNxQUsed[next][k] = false;
+  sNxQFrame = next;
+  NxGpuStamp(0);
+}
+#endif
+// ---- end NX_GPU_STAMPS ----
